# Universal Ecosystem Configuration
# Service Identification
SERVICE_NAME=UniversalLegoPool
ENVIRONMENT=production

# Security Baselines
# In industrial scenarios, this would be a secret key for JWT signing/verification
AUTH_SECRET_KEY=
# VALID_POOL_TOKEN_ADMIN is a development-mode bypass for testing trajectories
ADMIN_BYPASS_TOKEN=VALID_POOL_TOKEN_ADMIN

# Telemetry & Monitoring
LOG_LEVEL=INFO
ENABLE_CONSOLE_LOGS=true
TELEMETRY_BUFFER_SIZE=100

# Infrastructure
# Port for the industrial server (if full-stack)
PORT=3000
HOST=0.0.0.0
REDIS_URL=redis://127.0.0.1:6379
MAX_RETRY_ATTEMPTS=5
INITIAL_RETRY_DELAY_MS=1000
